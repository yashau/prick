# =============================================================================
# AUTH AND REGISTRY ONLY. NOTHING ELSE BELONGS IN THIS FILE.
#
# pnpm 11 no longer reads pnpm settings from .npmrc (nor from the `pnpm` field
# of package.json). A setting such as `minimum-release-age` or
# `only-built-dependencies` written here is NOT an error and produces NO
# warning -- it is silently ignored, which is the worst possible failure mode
# for a security control.
#
# The entire supply-chain policy therefore lives in pnpm-workspace.yaml.
# If you are about to add a line here, it almost certainly belongs there.
# =============================================================================

registry=https://registry.npmjs.org/
@yashau:registry=https://registry.npmjs.org/

# Publishing is done by CI with npm (not pnpm) via trusted publishing / OIDC,
# which needs no token at all. The line below exists only to document the
# fallback shape for the one-time bootstrap publish; CI writes it to a
# throwaway .npmrc rather than committing a token here.
#
# //registry.npmjs.org/:_authToken=${NODE_AUTH_TOKEN}
