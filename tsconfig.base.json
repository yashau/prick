{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,

    // `isolatedModules` + `verbatimModuleSyntax` are what make the source
    // transpilable file-by-file. Every bundler in this repo (Vite, esbuild via
    // vitest-pool-workers, oxc via vite-plus) does exactly that, so anything
    // requiring whole-program knowledge to emit correctly is a latent bug.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,

    "noEmit": true
  }
}
