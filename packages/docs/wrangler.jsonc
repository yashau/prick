{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // A SEPARATE Worker from the application. Different name, different
  // release workflow (.github/workflows/docs-release.yml, triggered by a
  // `docs-v*` tag push from `mise run docs:cut`), different hostname. Nothing
  // here touches D1, MASTER_KEY or Cloudflare Access.
  "name": "prick-docs",
  "compatibility_date": "2026-08-01",

  // ===========================================================================
  // THE SAME TWO LINES AS THE APP, FOR A COMPLETELY DIFFERENT REASON. DO NOT
  // COPY EITHER FILE'S REASONING ONTO THE OTHER.
  //
  // packages/app/wrangler.jsonc sets these because there they are a SECURITY
  // control, and CI greps that file for both. Cloudflare Access attaches to a
  // HOSTNAME, not to a Worker, so a *.workers.dev hostname or a per-version
  // preview URL serves the application with no authentication whatsoever:
  // every project, every environment, every reveal endpoint, open to the
  // internet. Those two lines are the whole of what prevents that.
  //
  // None of that reasoning applies here. This Worker serves pre-rendered
  // Markdown that is already public on GitHub. It has no bindings, no secrets,
  // no database and no authenticated surface, so there is nothing for an
  // unprotected hostname to expose, and nothing in this file is a security
  // control.
  //
  // They are off because the site has a real hostname now.
  // `docs.getprick.dev` is what every built page advertises as canonical (see
  // `site` in astro.config.ts). A workers.dev subdomain, and a preview URL per
  // version, would serve byte-identical pages from further addresses -- a
  // duplicate of every canonical URL on the site, and one more place a stale
  // copy can be linked from and indexed. One site, one address.
  //
  // So: same values, opposite arguments. Turning these back on here endangers
  // nothing; it just gives the site aliases it has no use for.
  // ===========================================================================
  "workers_dev": false,
  "preview_urls": false,

  // ---------------------------------------------------------------------------
  // Static assets, and nothing else.
  //
  // There is no `main`. This is an assets-only Worker: the runtime serves
  // `dist/` directly and no JavaScript of ours ever executes. Consequently
  // there is also no `binding` -- a binding exists so that Worker code can
  // fetch an asset, and there is no Worker code here.
  //
  // `not_found_handling` points at the 404 page Starlight generates. Left at
  // its default ("none") a miss would return a bare, unstyled 404 from the
  // runtime.
  // ---------------------------------------------------------------------------
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },

  // The custom hostname -- and, with workers.dev and preview URLs off above,
  // the ONLY one. Delete this route and `wrangler deploy` has nowhere to put
  // the Worker; it fails rather than quietly publishing somewhere else.
  //
  // `custom_domain` (not a plain route pattern) is what makes Cloudflare own
  // the DNS record and the certificate for `docs.getprick.dev` on the
  // `getprick.dev` zone, so there is no CNAME to keep in step by hand.
  //
  // Changing it is half a change. `site` in `astro.config.ts` is what the built
  // pages advertise as canonical, and the two naming different hostnames is
  // worse than either one being provisional -- do both in the same commit.
  // scripts/docs.test.mjs asserts they agree.
  "routes": [{ "pattern": "docs.getprick.dev", "custom_domain": true }],

  "observability": {
    "enabled": true,
  },
}
