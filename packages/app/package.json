{
  "name": "@prick/app",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types --strict-vars=false && vp fmt worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@prick/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
