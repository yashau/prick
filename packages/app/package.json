    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
