{
  "name": "@prick/app",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
