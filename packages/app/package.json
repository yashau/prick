    "hono-openapi": "^1.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.49.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
