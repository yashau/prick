{
  // `$app/tsconfig` is generated into `node_modules/$app` by `svelte-kit sync`
  // and carries the `rootDirs` for the generated ./$types modules. It must come
  // LAST so its settings win over the shared base. `#lib` resolves through the
  // `imports` field of package.json, not through `paths`.
  "extends": ["../../tsconfig.base.json", "$app/tsconfig"],

  // The program: the app, its tests, and the two config files.
  "include": ["src", "vite.config.ts", "drizzle.config.ts", "test"],

  // Generated by `wrangler types`. It sits at the package root, outside the
  // globs above, so it has to be named explicitly. `files` unions with
  // `include` rather than replacing it.
  "files": ["./worker-configuration.d.ts"],

  "compilerOptions": {
    // `checkJs` is deliberately OFF. svelte-check discovers JavaScript across
    // the whole package directory rather than only the tsconfig program, so
    // enabling it makes every build artefact under `.svelte-kit/output` and
    // `.svelte-kit/cloudflare` a source of hundreds of errors -- i.e. the
    // typecheck passes on a clean tree and fails immediately after a build.
    "checkJs": false,
    // `$app/types` is the generated ambient declarations ($app/*, $env/*,
    // App.*); listing `types` at all replaces the inherited list, so it is
    // named again here. The `cloudflare:test` module (SELF, env,
    // applyD1Migrations, ...) is declared in the package's `./types` SUBPATH,
    // not at its root -- the root entry is the pool implementation and declares
    // nothing. Naming the bare package here typechecks as a no-op and leaves
    // the test files broken.
    "types": ["$app/types", "node", "@cloudflare/vitest-plugin/types"]
  }
}
