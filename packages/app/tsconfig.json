{
  // `.svelte-kit/tsconfig.json` is generated by `svelte-kit sync` and carries
  // the $lib/$app path mappings and the generated ./$types modules. It must
  // come LAST so its `paths`/`rootDirs` win over the shared base.
  "extends": ["../../tsconfig.base.json", "./.svelte-kit/tsconfig.json"],

  // Generated by `wrangler types`. It sits at the package root, outside the
  // `../src/**` globs the SvelteKit-generated config brings in, so it has to be
  // named explicitly. `files` unions with the inherited `include` rather than
  // replacing it.
  "files": ["./worker-configuration.d.ts"],

  "compilerOptions": {
    // `checkJs` is deliberately OFF. svelte-check discovers JavaScript across
    // the whole package directory rather than only the tsconfig program, so
    // enabling it makes every build artefact under `.svelte-kit/output` and
    // `.svelte-kit/cloudflare` a source of hundreds of errors -- i.e. the
    // typecheck passes on a clean tree and fails immediately after a build.
    // The only hand-written JS here is svelte.config.js, which is JSDoc-typed
    // for editor support and is not part of the program either way.
    "allowJs": true,
    "checkJs": false,
    // The `cloudflare:test` module (SELF, env, applyD1Migrations, ...) is
    // declared in the package's `./types` SUBPATH, not at its root -- the root
    // entry is the pool implementation and declares nothing. Naming the bare
    // package here typechecks as a no-op and leaves the test files broken.
    "types": ["node", "@cloudflare/vitest-pool-workers/types"]
  }
}
